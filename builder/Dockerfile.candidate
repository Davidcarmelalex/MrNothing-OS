# syntax=docker/dockerfile:1.7
# CI-003J: unapproved, offline-input toolchain candidate; NOT a release builder.
# The two linux/amd64 manifest digests were resolved read-only on 2026-11-14.
FROM --platform=linux/amd64 docker.io/library/eclipse-temurin@sha256:65e4eb734734a9ed4cd07ca5142c391c25ed482360f2570e138d2609d6ef9024 AS jdk
FROM --platform=linux/amd64 docker.io/library/python@sha256:83f339c1be6340ae1096010fdccf6552ac932d8f410d45d206014916bdf37e48 AS candidate
COPY --from=jdk /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV ANDROID_HOME=/opt/android
ENV PATH="/opt/java/openjdk/bin:/opt/gradle/gradle-8.9/bin:/opt/android/cmdline-tools/latest/bin:${PATH}"
COPY builder/inputs/commandlinetools-linux-16111833_latest.zip /tmp/commandlinetools.zip
COPY builder/inputs/gradle-8.9-bin.zip /tmp/gradle.zip
RUN printf '%s  %s\n' '0877a1d048fe4a24efe2eff536ca4223f7adeb58648bb81909d33c446918cfa8' /tmp/commandlinetools.zip 'd725d707bfabd4dfdc958c624003b3c80accc03f7037b5122c4b1d0ef15cecab' /tmp/gradle.zip | sha256sum --check --strict
RUN python3 - <<'PY'
import pathlib, zipfile, os
for archive, target, expected in [
    ('/tmp/commandlinetools.zip', '/opt/android/cmdline-tools/latest', 'cmdline-tools/'),
    ('/tmp/gradle.zip', '/opt/gradle/gradle-8.9', 'gradle-8.9/'),
]:
    root=pathlib.Path(target)
    root.mkdir(parents=True,exist_ok=True)
    with zipfile.ZipFile(archive) as z:
        for member in z.infolist():
            name=member.filename
            if not name.startswith(expected) or '..' in pathlib.PurePosixPath(name).parts or member.is_dir() and name=='/':
                raise ValueError('unexpected archive member')
            rel=pathlib.PurePosixPath(name).relative_to(expected)
            dest=root.joinpath(*rel.parts)
            if member.is_dir():
                dest.mkdir(parents=True,exist_ok=True)
            else:
                dest.parent.mkdir(parents=True,exist_ok=True)
                with z.open(member) as source, dest.open('wb') as output:
                    import shutil
                    shutil.copyfileobj(source,output)
                if '/bin/' in name:
                    dest.chmod(0o755)
PY
RUN python3 --version && java -version && /opt/gradle/gradle-8.9/bin/gradle --version
RUN groupadd -g 10001 builder && useradd --create-home -u 10001 -g 10001 builder
RUN mkdir -p /workspace && chown 10001:10001 /workspace
USER 10001:10001
WORKDIR /workspace
# Android platform/build-tools are NOT present. No sdkmanager, signing, OTA, or release run.
